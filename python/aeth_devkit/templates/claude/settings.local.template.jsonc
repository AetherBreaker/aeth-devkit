{
    "env": {
        "PYTHONPYCACHEPREFIX": "{project_root}/.cache/pycache"
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "{devkit_bin} hook pre-edit-protect",
                        "shell": "bash"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "{devkit_bin} hook pre-bash-protect-deps",
                        "shell": "bash"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "{devkit_bin} hook stop-ruff",
                        "shell": "bash",
                        "timeout": 30
                    },
                    {
                        "type": "command",
                        "command": "{devkit_bin} hook stop-pyright",
                        "shell": "bash",
                        "timeout": 60
                    },
                    {
                        "type": "command",
                        "command": "{devkit_bin} hook stop-clean",
                        "shell": "bash",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}
